# Copie ce fichier en .env et renseigne les valeurs. Aucun secret ne doit être versionné.
# Le serveur écoute en local uniquement par défaut (pilote monoposte).

CODIR_HOST=127.0.0.1
CODIR_PORT=8765
CODIR_DATA_DIR=./data
# Répertoire surveillé pour les documents de référence (DOCX, PDF textuel, TXT, MD)
CODIR_DOCS_DIR=./data/documents
# Mode de participation par défaut : dialogue_dirige | codir_assiste | codir_actif
CODIR_DEFAULT_MODE=codir_assiste

# --- Modèle de langage ---------------------------------------------------
# anthropic : API Claude (clé requise) | simulated : mode SIMULÉ, étiqueté, sans appel réseau
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Effort de raisonnement : low | medium | high | xhigh | max (medium = latence adaptée à l'oral)
ANTHROPIC_EFFORT=medium
# Repli serveur en cas de refus de sécurité du modèle (bêta server-side-fallback) : on | off
ANTHROPIC_FALLBACKS=on

# --- Transcription (parole -> texte) --------------------------------------
# openai_compatible : endpoint POST {STT_BASE_URL}/audio/transcriptions (OpenAI, Groq, faster-whisper-server…)
# browser : reconnaissance vocale du navigateur (Chrome/Edge envoient l'audio à leur fournisseur)
# none : transcription désactivée (saisie clavier uniquement)
STT_PROVIDER=openai_compatible
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=fr

# --- Synthèse vocale (texte -> parole) ------------------------------------
# openai_compatible : endpoint POST {TTS_BASE_URL}/audio/speech | browser : voix du navigateur | none
TTS_PROVIDER=openai_compatible
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- Embeddings (recherche sémantique, optionnelle) -----------------------
# none : recherche lexicale seule | openai_compatible : POST {EMBEDDINGS_BASE_URL}/embeddings (OpenAI, Voyage…)
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Politique d'intervention ---------------------------------------------
# Délai minimal entre deux interventions spontanées (secondes)
INTERVENTION_MIN_DELAY_S=90
# Longueur orale maximale d'une intervention (caractères)
INTERVENTION_MAX_CHARS=600
